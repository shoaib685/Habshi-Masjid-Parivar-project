# Run `pnpm generate:admin-hash` and paste its output here.
ADMIN_PASSWORD_HASH=

# Run `pnpm generate:session-secret` and paste its output here.
ADMIN_SESSION_SECRET=

# Must be a persistent, writable directory on the Node host.
# In production, mount a persistent volume here before starting the server.
HMP_DATA_DIR=./data

# Generate with `pnpm generate:vapid-keys`. Only the public key is sent to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Optional SMS fallback. Twilio requests are only sent when all values are configured.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional shared secret for POST /api/scheduler/duty-reminders.
# Use a unique random value of at least 32 bytes.
HMP_SCHEDULER_SECRET=
